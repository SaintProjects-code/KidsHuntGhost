; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kids Hunt Ghost"
run/main_scene="res://Scenes/Menu/MainMenu.tscn"
config/features=PackedStringArray("4.1", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://Global/EventBus.gd"
GameState="*res://Global/GameState.gd"
SpiritsData="*res://Data/SpiritsData.gd"
TurnSystem="*res://Systems/TurnSystem.gd"
SaveManager="*res://Global/SaveManager.gd"
UIManager="*res://Systems/UIManager.gd"
SpaceResolver="*res://Systems/SpaceResolver.gd"
CatchSystem="*res://Systems/CatchSystem.gd"
SpiritsProgressionSystem="*res://Systems/SpiritsProgressionSystem.gd"

[display]

window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
